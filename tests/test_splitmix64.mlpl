# SplitMix64 library (lib/splitmix64) against reference values.
# References: the published splitmix64 outputs for seed 0, and a Python
# transcription of microgpt-rs's Rng (arbitrary-precision ints, same libm).
include "lib/splitmix64/splitmix64.mlpl";

def u:hex4(v) {
  "Four lowercase hex digits of a 16-bit limb.";
  h = "0123456789abcdef";
  str_concat(str_concat(str_slice(h, floor(v / 4096), 1), str_slice(h, mod(floor(v / 256), 16), 1)), str_concat(str_slice(h, mod(floor(v / 16), 16), 1), str_slice(h, mod(v, 16), 1)))
}

def u:hex64(x, i) {
  "Draw i of a word of limb vectors as 16 hex digits.";
  str_concat(str_concat(u:hex4(at(x.l3, i)), u:hex4(at(x.l2, i))), str_concat(u:hex4(at(x.l1, i)), u:hex4(at(x.l0, i))))
}

@test {name: "raw 64-bit outputs match splitmix64 reference values", tags: ["splitmix64"]}
def u:test_raw() {
  "Seed 0 (published) and seed 42 (microgpt-rs's seed), exact to the bit.";
  z = u:sm64_next(0, [1, 2]);
  u:assert_text_eq(u:hex64(z, 0), "e220a8397b1dcdaf", "seed 0, draw 1")?;
  u:assert_text_eq(u:hex64(z, 1), "6e789e6aa1b965f4", "seed 0, draw 2")?;
  s = u:sm64_next(42, [1, 2, 3]);
  u:assert_text_eq(u:hex64(s, 0), "bdd732262feb6e95", "seed 42, draw 1")?;
  u:assert_text_eq(u:hex64(s, 1), "28efe333b266f103", "seed 42, draw 2")?;
  u:assert_text_eq(u:hex64(s, 2), "47526757130f9f52", "seed 42, draw 3")
}

@test {name: "uniforms and modulo draws are exact", tags: ["splitmix64"]}
def u:test_uniform_mod() {
  "(next >> 11) / 2^53 and next % m, as microgpt-rs computes them.";
  u:assert_eq(u:sm64_uniform(42, [1, 2, 3]), [0.7415648787718233, 0.1599103928769201, 0.27860113025513866], "uniforms")?;
  u:assert_eq(u:sm64_mod(42, [1, 2, 3, 4], 1000), [413, 291, 858, 764], "next % 1000")
}

@test {name: "gauss is microgpt-rs's Box-Muller to the last bit", tags: ["splitmix64"]}
def u:test_gauss() {
  "mu + sigma * sqrt(-2 ln u1) * cos(2 pi u2), two draws per value.";
  u:assert_eq(unwrap(u:sm64_gauss(7, 1, 3, 0, 0.08)), [0.10919938379657827, 0 - 0.03172191802030545, 0.00035988209278656734], "seed 7")
}

@test {name: "shuffle head equals a full sequential Fisher-Yates", tags: ["splitmix64"]}
def u:test_shuffle() {
  "Small case in full; microgpt-rs's 32033-doc shuffle head; the stream continues after n - 1 draws.";
  u:assert_eq(u:sm64_shuffle_head(42, 1, 10, 10), [0, 9, 5, 8, 6, 4, 7, 2, 1, 3], "shuffle(range(10))")?;
  head = u:sm64_shuffle_head(42, 1, 32033, 8);
  u:assert_eq(head, [7650, 15020, 12483, 21443, 20388, 1679, 6626, 3097], "32033 docs, first 8")?;
  u:assert_eq(unwrap(u:sm64_gauss(42, 32033, 3, 0, 0.08)), [0 - 0.06139961113581061, 0 - 0.13226159684109878, 0 - 0.09602354218642606], "gauss continues at draw n")
}

u:run_registered_tests()
