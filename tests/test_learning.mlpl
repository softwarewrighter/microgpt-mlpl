# A short training run learns (separate file: fresh params and adam state).
include "lib/data.mlpl";
d = unwrap(u:dataset(load("input.txt")));
vocab_size = d.vocab_size;
include "lib/params.mlpl";
include "lib/model.mlpl";
batch = u:doc_batch(d, u:gather1(shuffle(range(d.n_docs), 42), range(200)), block_size);
tokens = batch.tokens;
ns = batch.n;
expunge(["d", "batch"]);

@test {name: "200 steps of the microgpt.py schedule lower the loss", tags: ["training"]}
def u:test_learns() {
  "Mean loss over steps 151-200 is below steps 1-50 by more than the ~0.07 noise of a 50-doc mean (observed 2.81 -> 2.55).";
  train 200 {
    u:set_doc(take(tokens, 0, step), at(ns, step));
    adam(u:loss(), [wte, wpe, lm_head, layer0_attn_wq, layer0_attn_wk, layer0_attn_wv, layer0_attn_wo, layer0_mlp_fc1, layer0_mlp_fc2], 0.01 * (1 - step / 1000), 0.85, 0.99, 0.00000001)
  };
  first = reduce_add(last_losses * lt(range(200), 50)) / 50;
  last = reduce_add(last_losses * ge(range(200), 150)) / 50;
  u:assert_lt(last, first - 0.15, "loss falls by > 0.15 (observed 0.25)")?;
  u:assert_lt(last, 2.9, "below uniform")
}

u:run_registered_tests()
