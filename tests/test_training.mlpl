# Training (microgpt.mlpl's Adam + loop) against microgpt.py's update rule.
include "lib/data.mlpl";
d = unwrap(u:dataset(load("input.txt")));
vocab_size = d.vocab_size;
include "lib/params.mlpl";
include "lib/model.mlpl";
batch = u:doc_batch(d, u:gather1(shuffle(range(d.n_docs), 42), range(200)), block_size);
tokens = batch.tokens;
ns = batch.n;
expunge(["d", "batch"]);

@test {name: "adam matches microgpt.py's bias-corrected update for two steps", tags: ["training"]}
def u:test_adam_rule() {
  "m = b1 m + (1-b1) g; v = b2 v + (1-b2) g^2; p -= lr * (m/(1-b1^t)) / (sqrt(v/(1-b2^t)) + eps), t = 1, 2.";
  inp = u:doc_in(take(tokens, 0, 0), at(ns, 0));
  tgt = u:doc_tgt(take(tokens, 0, 0), at(ns, 0));
  mask = u:causal_mask(at(ns, 0));
  w0 = layer0_attn_wv;
  g1 = grad(u:loss(inp, tgt, mask), layer0_attn_wv);
  l1 = u:loss(inp, tgt, mask);
  r1 = adam(u:loss(inp, tgt, mask), [wte, wpe, lm_head, layer0_attn_wq, layer0_attn_wk, layer0_attn_wv, layer0_attn_wo, layer0_mlp_fc1, layer0_mlp_fc2], 0.01, 0.85, 0.99, 0.00000001);
  u:assert_approx(r1, l1, 0.000000000001, "adam returns the pre-update loss")?;
  m1 = 0.15 * g1;
  v1 = 0.01 * g1 * g1;
  w1 = w0 - 0.01 * (m1 / 0.15) / (sqrt(v1 / 0.01) + 0.00000001);
  u:assert_approx(layer0_attn_wv, w1, 0.000000000001, "step 1")?;
  inp = u:doc_in(take(tokens, 0, 1), at(ns, 1));
  tgt = u:doc_tgt(take(tokens, 0, 1), at(ns, 1));
  mask = u:causal_mask(at(ns, 1));
  g2 = grad(u:loss(inp, tgt, mask), layer0_attn_wv);
  adam(u:loss(inp, tgt, mask), [wte, wpe, lm_head, layer0_attn_wq, layer0_attn_wk, layer0_attn_wv, layer0_attn_wo, layer0_mlp_fc1, layer0_mlp_fc2], 0.005, 0.85, 0.99, 0.00000001);
  m2 = 0.85 * m1 + 0.15 * g2;
  v2 = 0.99 * v1 + 0.01 * g2 * g2;
  w2 = w1 - 0.005 * (m2 / (1 - 0.85 * 0.85)) / (sqrt(v2 / (1 - 0.99 * 0.99)) + 0.00000001);
  u:assert_approx(layer0_attn_wv, w2, 0.000000000001, "step 2")
}

u:run_registered_tests()
