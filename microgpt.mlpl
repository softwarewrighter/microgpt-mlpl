# microgpt.mlpl -- Karpathy's microgpt.py, ported to sw-MLPL.
#
# "The most atomic way to train and run inference for a GPT."
# Sections follow microgpt.py one-to-one; see docs/plan.md.
# Run with scripts/run.sh (it supplies --data-dir . and input.txt).
# Reusable definitions live in lib/ so the mlplunit suites can test them.

include "lib/data.mlpl";
include "lib/format.mlpl";
include "lib/splitmix64/splitmix64.mlpl";

# RNG mode. Default: MLPL's own seeded generators. With `-- --rs-parity`,
# every random number comes from microgpt-rs's SplitMix64 stream (seed 42:
# doc shuffle, then weights, then sampling), so the output can be diffed
# line for line against microgpt-rs (scripts/parity.sh).
rs_parity = if len(args()) { str_eq(unwrap(list_get(args(), 0)), "--rs-parity") } else { 0 };

# Let there be a Dataset `docs`: one name per line of input.txt.
# Python shuffles the list in place; here the docs stay in file order and
# the training loop visits them in a shuffled order (built below).
d = unwrap(u:dataset(load("input.txt")));
print("num docs:", to_string(d.n_docs));

# Let there be a Tokenizer: the unique characters become token ids
# 0..n-1, and one extra id, BOS, marks the beginning (and end) of a doc.
print("vocab size:", to_string(d.vocab_size));
vocab_size = d.vocab_size;

# Initialize the parameters, to store the knowledge of the model:
# hyperparameters and one param[...] leaf per state_dict matrix.
include "lib/params.mlpl";
if rs_parity {
  # microgpt-rs draws 4192 gauss(0, 0.08) values right after its n - 1
  # shuffle draws, filling wte, wpe, lm_head, then layer 0, row-major.
  w = unwrap(u:sm64_gauss(42, d.n_docs, num_params, 0, init_std));
  o = 0;
  wte = reshape(u:gather1(w, o + range(size(wte))), shape(wte)); o = o + size(wte);
  wpe = reshape(u:gather1(w, o + range(size(wpe))), shape(wpe)); o = o + size(wpe);
  lm_head = reshape(u:gather1(w, o + range(size(lm_head))), shape(lm_head)); o = o + size(lm_head);
  layer0_attn_wq = reshape(u:gather1(w, o + range(size(layer0_attn_wq))), shape(layer0_attn_wq)); o = o + size(layer0_attn_wq);
  layer0_attn_wk = reshape(u:gather1(w, o + range(size(layer0_attn_wk))), shape(layer0_attn_wk)); o = o + size(layer0_attn_wk);
  layer0_attn_wv = reshape(u:gather1(w, o + range(size(layer0_attn_wv))), shape(layer0_attn_wv)); o = o + size(layer0_attn_wv);
  layer0_attn_wo = reshape(u:gather1(w, o + range(size(layer0_attn_wo))), shape(layer0_attn_wo)); o = o + size(layer0_attn_wo);
  layer0_mlp_fc1 = reshape(u:gather1(w, o + range(size(layer0_mlp_fc1))), shape(layer0_mlp_fc1)); o = o + size(layer0_mlp_fc1);
  layer0_mlp_fc2 = reshape(u:gather1(w, o + range(size(layer0_mlp_fc2))), shape(layer0_mlp_fc2));
  expunge(["w", "o"])
} else { 0 };
print("num params:", to_string(num_params));

# Define the model architecture: a function mapping tokens and parameters
# to logits over what comes next (u:gpt), and the per-doc loss (u:loss).
include "lib/model.mlpl";

# Let there be Adam, the blessed optimizer. MLPL's adam keeps the m/v
# moment buffers per param across calls and bias-corrects exactly like
# microgpt.py; the param list must be written inline in the call.
learning_rate = 0.01;
beta1 = 0.85;
beta2 = 0.99;
eps_adam = 0.00000001;

# Repeat in sequence. Each step takes one doc (docs[step % len(docs)] in
# shuffled order). The docs a run visits are encoded up front in one
# vectorized pass: rows of [BOS] + ids + [BOS], and n = min(block_size,
# len(tokens) - 1) positions per doc (see docs/benchmarks.md for why).
num_steps = 1000;
train_ids = if rs_parity {
  # microgpt-rs's Fisher-Yates over all docs, first num_steps positions
  u:sm64_shuffle_head(42, 1, d.n_docs, num_steps)
} else {
  u:gather1(shuffle(range(d.n_docs), 42), mod(range(num_steps), d.n_docs))
};
train_docs = u:doc_batch(d, train_ids, block_size);
train_tokens = train_docs.tokens;
train_n = train_docs.n;
# Keep what inference needs, then drop the big arrays: in this
# interpreter every u: call copies the global environment, so a 228k
# corpus left in scope costs ~0.05 ms per call (docs/benchmarks.md).
uchars = d.uchars;
BOS = d.bos;
n_docs = d.n_docs;
expunge(["d", "train_ids", "train_docs", "txt"]);

train num_steps {
  row = take(train_tokens, 0, step);
  n = at(train_n, step);
  inp = u:doc_in(row, n);
  tgt = u:doc_tgt(row, n);
  mask = u:causal_mask(n);
  # Forward the doc, backward the loss, and update every parameter.
  # adam returns the loss before the update (Python's loss.data).
  lr_t = learning_rate * (1 - step / num_steps);
  loss = adam(u:loss(inp, tgt, mask), [wte, wpe, lm_head, layer0_attn_wq, layer0_attn_wk, layer0_attn_wv, layer0_attn_wo, layer0_mlp_fc1, layer0_mlp_fc2], lr_t, beta1, beta2, eps_adam);
  u:write(str_concat(str_concat(str_concat(str_concat(str_concat("step ", u:fmt_int(step + 1, 4)), " / "), u:fmt_int(num_steps, 4)), " | loss "), str_concat(u:fmt_fixed4(loss), "\r")));
  loss
}

# Inference: may the model babble back to us. temperature in (0, 1]
# controls the "creativity" of generated text, low to high. One uniform
# stream drives every draw, consumed in order across samples; in parity
# mode it continues microgpt-rs's stream after the weight draws.
include "lib/sample.mlpl";
temperature = 0.5;
num_samples = 20;
sample_uniforms = if rs_parity {
  u:sm64_uniform(42, n_docs + 2 * num_params + range(num_samples * block_size))
} else {
  random(4242, [num_samples * block_size])
};
cursor = 0;
print("");
print("--- inference (new, hallucinated names) ---");
sample_idx = 0;
repeat num_samples {
  ids = u:generate(sample_uniforms, cursor, temperature);
  cursor = cursor + u:consumed(ids);
  name = u:ids_to_text(ids);
  print(str_concat(str_concat(str_concat("sample ", u:fmt_int(sample_idx + 1, 2)), ": "), name));
  sample_idx = sample_idx + 1
}

exit(0)
